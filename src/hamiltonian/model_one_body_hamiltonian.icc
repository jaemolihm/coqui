#include "configuration.hpp"
#include "utilities/check.hpp"
#include "utilities/proc_grid_partition.hpp"
#include "numerics/distributed_array/nda.hpp"
#include "mean_field/MF.hpp"

namespace hamilt::detail
{
/**
 * One-body matrices of a model Hamiltonian, copied from the in-memory model system
 * (replicated on every rank) into a distributed array.
 * @param mf      - [INPUT] mean-field object of type model_source
 * @param which   - [INPUT] "H0", "Fock" or "ovlp"
 * @param comm    - [INPUT] communicator for the output distributed array
 * @param k_range - [INPUT] k-point range (IBZ indices)
 * @param b_range - [INPUT] orbital range
 * @param pgrid   - [INPUT] processor grid for the distributed array
 * @param bz      - [INPUT] block size for the distributed array
 * @return - one-body matrix with global shape = (nspin, k_range.size(), b_range.size(), b_range.size())
 */
template<MEMORY_SPACE MEM = HOST_MEMORY>
auto model_1B(mf::MF& mf, std::string which, boost::mpi3::communicator& comm,
              nda::range k_range, nda::range b_range,
              std::array<long,4> pgrid = {0}, std::array<long,4> bz = {1,1,2048,2048})
{
  auto sys = mf.model_sys();
  utils::check(sys != nullptr, "model_1B: mf is not a model Hamiltonian.");
  long nspin = mf.nspin_in_basis();
  long nkpts = k_range.size();
  long M = b_range.size();
  utils::check(b_range.first() >= 0 and b_range.last() <= mf.nbnd()*mf.npol_in_basis(), "Band range out of bounds.");
  utils::check(k_range.first() >= 0 and k_range.last() <= mf.nkpts_ibz(), "K-point range out of bounds.");
  if( (pgrid==std::array<long,4>{0}) ) {
    long sz = comm.size();
    long ps = (sz%nspin==0?nspin:1);
    long n_ = sz/ps;
    long pk = utils::find_proc_grid_max_rows(n_,nkpts);
    pgrid = {ps,pk,n_/pk,1};
  }
  utils::check(comm.size() == std::accumulate(pgrid.cbegin(), pgrid.cend(), long(1), std::multiplies<>{}),
               "model_1B: MPI size mismatch.");

  nda::array<ComplexType,4> const* A = nullptr;
  if(which == "H0") A = std::addressof(sys->H0);
  else if(which == "Fock") A = std::addressof(sys->FockM);
  else if(which == "ovlp") A = std::addressof(sys->S);
  else APP_ABORT("model_1B: Unknown matrix: {}", which);

  using larray = memory::array<MEM,ComplexType,4>;
  auto Hij = math::nda::make_distributed_array<larray>(comm,pgrid,{nspin,nkpts,M,M},bz);
  auto rs = Hij.local_range(0);
  auto rk = Hij.local_range(1);
  auto ri = Hij.local_range(2);
  auto rj = Hij.local_range(3);
  nda::array<ComplexType,4> H_loc = (*A)(rs, nda::range(k_range.first()+rk.first(), k_range.first()+rk.last()),
                                         nda::range(b_range.first()+ri.first(), b_range.first()+ri.last()),
                                         nda::range(b_range.first()+rj.first(), b_range.first()+rj.last()));
  Hij.local() = H_loc;
  return Hij;
}

/**
 * Diagonal of a one-body matrix of a model Hamiltonian in a distributed array.
 * @return - distributed array with global shape = (nspin, k_range.size(), b_range.size())
 */
template<MEMORY_SPACE MEM = HOST_MEMORY>
auto model_diag_1B(mf::MF& mf, std::string which, boost::mpi3::communicator& comm,
                   nda::range k_range, nda::range b_range,
                   std::array<long,3> pgrid = {0}, std::array<long,3> bz = {1,1,2048})
{
  decltype(nda::range::all) all;
  long nspin = mf.nspin_in_basis();
  long nkpts = k_range.size();
  long M = b_range.size();
  if( (pgrid==std::array<long,3>{0}) ) {
    long sz = comm.size();
    long ps = (sz%nspin==0?nspin:1);
    long n_ = sz/ps;
    long pk = utils::find_proc_grid_max_rows(n_,nkpts);
    pgrid = {ps,pk,n_/pk};
  }
  auto Hij = model_1B<HOST_MEMORY>(mf, which, comm, k_range, b_range,
                                   {pgrid[0],pgrid[1],pgrid[2],1}, {bz[0],bz[1],bz[2],2048});

  using larray3D = memory::array<MEM,ComplexType,3>;
  auto Hii = math::nda::make_distributed_array<larray3D>(comm,pgrid,{nspin,nkpts,M},bz);
  utils::check(Hii.origin()[2] == Hij.origin()[2] and Hii.local_shape()[2] == Hij.local_shape()[2],
               "model_diag_1B: inconsistent band distribution.");
  // Hij has local rows i0 + [0,m_loc) and all columns: the diagonal is Hsk(i, i0+i)
  long i0 = Hij.origin()[2];
  nda::array<ComplexType,3> Hii_loc(Hii.local_shape());
  for( auto is : nda::range(Hij.local_shape()[0]) )
    for( auto ik : nda::range(Hij.local_shape()[1]) ) {
      auto Hsk = Hij.local()(is,ik,all,all);
      for( auto i : nda::range(Hij.local_shape()[2]) )
        Hii_loc(is,ik,i) = Hsk(i,i0+i);
    }
  Hii.local() = Hii_loc;
  return Hii;
}

} // hamilt::detail
