#include <algorithm>
#include <tuple>
#include <utility>
#include <vector>

#include "numerics/distributed_array/slate_ops.hpp"

namespace methods {
namespace solvers {

/**
 * Compute W_full(iω) = W_c(iω) + V from W_c(τ).
 *
 * FTs W_c(τ) → W_c(iω) into the LR ω-side {nwpools, nqpools, np_P, np_Q}
 * distribution, then adds the bare interaction Z(q) at each (q, iω) slice.
 */
template<nda::MemoryArrayOfRank<4> local_Array_t, typename communicator_t>
auto lr_scr_coulomb_t::compute_W_full_omega(
    memory::darray_t<local_Array_t, communicator_t>& dW_c_tqPQ,
    THC_ERI auto& thc,
    bool reset_input)
-> memory::darray_t<local_Array_t, mpi3::communicator>
{
  _Timer.start("LR_W_COMPUTE_W_FULL");

  auto [nt_half, nqpts, NP, NQ] = dW_c_tqPQ.global_shape();
  long nproc = thc.mpi()->comm.size();
  long nw_half = (_ft->nw_b()%2==0)? _ft->nw_b()/2 : _ft->nw_b()/2 + 1;

  // Distribution for W_full(iω).
  // ft_buffer_dist keeps w local, distributes over q, then P and Q.
  // lr_W_proc_grid distributes over w and q, then P and Q.
  // If FT buffer has P and Q local, use it for W_full to skip the redundant redistributions.
  // If not, use a separate lr_W_proc_grid distribution to make P and Q as local as possible.
  auto [b_pgrid, b_bsize] =
      scr_coulomb_fourier_t::ft_buffer_dist(nproc, {nw_half, nqpts, NP, NQ});
  std::array<long, 4> w_pgrid, w_bsize;
  if (b_pgrid[2] == 1 && b_pgrid[3] == 1) {
    w_pgrid = b_pgrid;
    w_bsize = b_bsize;
  } else {
    std::tie(w_pgrid, w_bsize) = utils::lr_W_proc_grid(nproc, nqpts, nw_half, NP);
  }

  // FT τ → ω directly into the chosen distribution.
  // Deliberately uses a local scr_coulomb_fourier_t (not the member _scr_fourier):
  // this is one-time setup, and keeping it separate leaves _scr_fourier's FT
  // component clocks attributable to the per-iteration solve_lr_dyson_W calls
  // only. The local engine is a trivial object (IAFT ptr + timer + flag), so
  // this carries none of the cost of the old throwaway scr_coulomb_t.
  scr_coulomb_fourier_t setup_ft(_ft);
  // Rank-uniform leak-check gate (see solve_lr_dyson_W): __app_output_level__
  // is a sentinel on non-root ranks and check_leakage is collective.
  int chk_leak = (__app_output_level__ >= 3) ? 1 : 0;
  thc.mpi()->comm.broadcast_n(&chk_leak, 1, 0);
  setup_ft.set_check_ft_leakage(chk_leak != 0);
  auto dW_c_wqPQ = setup_ft.tau_to_w(dW_c_tqPQ, w_pgrid, w_bsize, reset_input);

  // Add bare interaction Z(q) at each (w, q) slice. PQ may be split across the
  // wq_intra subgroup, so use the sub-block version of thc.Z.
  auto [nw_loc, nq_loc, NP_loc, NQ_loc] = dW_c_wqPQ.local_shape();
  auto [w_origin, q_origin, P_origin, Q_origin] = dW_c_wqPQ.origin();
  auto P_rng = dW_c_wqPQ.local_range(2);
  auto Q_rng = dW_c_wqPQ.local_range(3);

  // q_intra_comm groups ranks that share the same q-tile (varying w, P, Q).
  // thc.Z's sub-block API uses this to allreduce the full Z across the
  // wq subgrid before slicing to (P_rng, Q_rng).
  mpi3::communicator q_intra_comm =
      thc.mpi()->comm.split(q_origin, thc.mpi()->comm.rank());
  utils::check(
      (long)q_intra_comm.size() == w_pgrid[0] * w_pgrid[2] * w_pgrid[3],
      "compute_W_full_omega: q_intra_comm size {} != pgrid[0]*pgrid[2]*pgrid[3] = {}",
      (long)q_intra_comm.size(), w_pgrid[0] * w_pgrid[2] * w_pgrid[3]);

  // q-pool id matches the convention in scr_coulomb_t::dyson_W_in_place:
  // when q tiles are uneven, the leftover q-points sit on the trailing tiles.
  long nq_loc_max = nq_loc;
  thc.mpi()->comm.broadcast_n(&nq_loc_max, 1, 0);
  long qpool_id = (nq_loc == nq_loc_max)
                  ? q_origin / std::max(nq_loc, 1L)
                  : (q_origin - nqpts % w_pgrid[1]) / std::max(nq_loc, 1L);

  auto W_c_loc = dW_c_wqPQ.local();
  for (long iq_loc = 0; iq_loc < nq_loc; ++iq_loc) {
    long iq = q_origin + iq_loc;
    auto Z_PQ = thc.Z(iq, P_rng, Q_rng, qpool_id, w_pgrid[1], q_intra_comm);
    for (long iw = 0; iw < nw_loc; ++iw) {
      W_c_loc(iw, iq_loc, nda::range::all, nda::range::all) += Z_PQ;
    }
  }
  // Prevent dead block in thc.Z() when q-tiles are uneven (some ranks have
  // fewer local q-points). Same idiom as scr_coulomb_t::dyson_W_in_place.
  for (long iq_loc = nq_loc; iq_loc < nq_loc_max; ++iq_loc) {
    auto Z_PQ = thc.Z(0L, P_rng, Q_rng, qpool_id, w_pgrid[1], q_intra_comm);
    (void)Z_PQ;
  }

  app_log(2, "  compute_W_full_omega:");
  app_log(2, "    - FT-buffer pgrid: ({}, {}, {}, {})",
          b_pgrid[0], b_pgrid[1], b_pgrid[2], b_pgrid[3]);
  app_log(2, "    - ω-side pgrid: ({}, {}, {}, {})",
          w_pgrid[0], w_pgrid[1], w_pgrid[2], w_pgrid[3]);
  app_log(2, "    - W_full shape: ({}, {}, {}, {})", nw_half, nqpts, NP, NQ);

  // Eagerly build the Q≠Γ left operand _dW_full_qpQ_wqPQ = W_full(q+Q).
  // This is used for the Dyson equation for DeltaW at Q≠Γ.
  _build_W_full_qpQ(dW_c_wqPQ, thc);

  _Timer.stop("LR_W_COMPUTE_W_FULL");
  return dW_c_wqPQ;
}

/**
 * Lazily initialize the q+Q mapping. No-op for Q=Γ — the Γ branch in
 * lr_dyson_W_in_place uses _is_q_gamma directly and never reads _kpq_map.
 */
void lr_scr_coulomb_t::_init_kpq_map(THC_ERI auto& thc) {
  if (_kpq_map_initialized || _is_q_gamma) return;
  long nkpts = thc.MF()->nkpts();
  auto kpts_crys = thc.MF()->kpts_crystal();
  _kpq_map.resize(nkpts);
  utils::calculate_kpq_map(kpts_crys, _q_pert, _kpq_map);
  _kpq_map_initialized = true;
}

/**
 * Build the Q≠Γ Dyson (q+Q) operand W_full(q+Q) into _dW_full_qpQ_wqPQ:
 *   dW_full_qpQ[iw, iq, P, Q] = dW_full_wqPQ[iw, kpq_map(iq), P, Q]
 * via an Alltoallv inside the q-pool subgroup (ranks sharing the same w/P/Q
 * tile, varying q-tile). No-op for Q=Γ (the Dyson then reuses W_full(q) for both
 * operands). Built once from compute_W_full_omega — W_full is constant across the
 * SCF loop. Concrete (not templated on the array type) so it can touch the
 * concrete member cache directly, keeping compute_W_full_omega's call out of an
 * `if constexpr` (and pinning setup to the concrete LR instantiation — a future
 * GPU build fails to compile here; see TODO_lr_cleanup.md).
 */
void lr_scr_coulomb_t::_build_W_full_qpQ(
    const dArr4D_concrete_t& dW_full_wqPQ, THC_ERI auto& thc) {
  if (_is_q_gamma) return;  // W_full(q+Q) = W_full(q); no separate operand needed
  _init_kpq_map(thc);
  _Timer.start("LR_W_COMM_QPQ");

  _dW_full_qpQ_wqPQ.emplace(math::nda::make_distributed_array<nda::array<ComplexType, 4>>(
      *dW_full_wqPQ.communicator(), dW_full_wqPQ.grid(),
      dW_full_wqPQ.global_shape(), dW_full_wqPQ.block_size()));
  auto& dW_full_qpQ = *_dW_full_qpQ_wqPQ;

  auto pgrid = dW_full_wqPQ.grid();
  auto [nw_loc, nq_loc, NP_loc, NQ_loc] = dW_full_wqPQ.local_shape();
  auto [nw_g, nq_g, NP_g, NQ_g] = dW_full_wqPQ.global_shape();
  auto [w_origin, q_origin, P_origin, Q_origin] = dW_full_wqPQ.origin();
  auto& comm = *dW_full_wqPQ.communicator();

  // q_pool_comm: same (w-tile, P-tile, Q-tile), varying q-tile.
  // Row-major rank decomposition: ip = w*Nq*Np*NQ + q*Np*NQ + p*NQ + Q.
  long ip = comm.rank();
  long Q_idx = ip % pgrid[3]; ip /= pgrid[3];
  long P_idx = ip % pgrid[2]; ip /= pgrid[2];
  long q_idx = ip % pgrid[1]; ip /= pgrid[1];
  long w_idx = ip;
  long color = w_idx * (pgrid[2] * pgrid[3]) + P_idx * pgrid[3] + Q_idx;
  mpi3::communicator q_pool_comm = comm.split(color, q_idx);
  utils::check((long)q_pool_comm.size() == pgrid[1],
               "_build_W_full_qpQ: q_pool_comm size {} != pgrid[1] {}",
               (long)q_pool_comm.size(), pgrid[1]);

  // q-pool decomposition (bsize[1]==1, contiguous chunks).
  // First (nq_g % pgrid[1]) tiles get one extra element; rest get base.
  long base = nq_g / pgrid[1];
  long extra = nq_g % pgrid[1];
  long edge = extra * (base + 1);
  auto q_pool_owner = [base, extra, edge](long iq_g) -> long {
    if (iq_g < edge) return iq_g / (base + 1);
    return extra + (iq_g - edge) / base;
  };
  auto q_pool_origin = [base, extra, edge](long pool_rank) -> long {
    if (pool_rank < extra) return pool_rank * (base + 1);
    return edge + (pool_rank - extra) * base;
  };

  // Inverse of the kpq permutation: kpq_inv[kpq_map[i]] = i.
  nda::array<long, 1> kpq_inv(nq_g);
  kpq_inv() = -1;
  for (long iq = 0; iq < nq_g; ++iq) {
    long jq = _kpq_map(iq);
    utils::check(jq >= 0 && jq < nq_g && kpq_inv(jq) == -1,
                 "_build_W_full_qpQ: kpq_map is not a valid permutation");
    kpq_inv(jq) = iq;
  }

  // Send/recv plans.
  // - I send my W_full(:, iq_loc, :, :) (global iq_g = q_origin + iq_loc) to the
  //   rank that owns kpq_inv(iq_g) (the rank whose ΔΠ at that local slot needs
  //   W_full at iq_g as its left operand).
  // - I receive into my dW_full_qpQ(:, iq_loc, :, :) the slice W_full(kpq_map(iq_g))
  //   from the rank that owns kpq_map(iq_g).
  std::vector<std::vector<std::pair<long,long>>> send_groups(pgrid[1]);
  std::vector<std::vector<std::pair<long,long>>> recv_groups(pgrid[1]);
  for (long iq_loc = 0; iq_loc < nq_loc; ++iq_loc) {
    long iq_g = q_origin + iq_loc;
    long inv = kpq_inv(iq_g);
    long dest_rank = q_pool_owner(inv);
    long dest_iq_loc = inv - q_pool_origin(dest_rank);
    send_groups[dest_rank].push_back({iq_loc, dest_iq_loc});

    long shifted = _kpq_map(iq_g);
    long src_rank = q_pool_owner(shifted);
    long src_iq_loc = shifted - q_pool_origin(src_rank);
    recv_groups[src_rank].push_back({iq_loc, src_iq_loc});
  }
  // Sort send by dest_iq_loc (= position on receiver), recv by my iq_loc_dst.
  // Both ends order by destination position so packed buffers line up.
  for (auto& g : send_groups)
    std::sort(g.begin(), g.end(),
              [](auto const& a, auto const& b){ return a.second < b.second; });
  for (auto& g : recv_groups)
    std::sort(g.begin(), g.end(),
              [](auto const& a, auto const& b){ return a.first < b.first; });

  long slice_sz = nw_loc * NP_loc * NQ_loc;
  std::vector<int> send_counts(pgrid[1], 0), send_disps(pgrid[1], 0);
  std::vector<int> recv_counts(pgrid[1], 0), recv_disps(pgrid[1], 0);
  long total_send = 0, total_recv = 0;
  for (long r = 0; r < pgrid[1]; ++r) {
    send_counts[r] = (int)(send_groups[r].size() * slice_sz);
    recv_counts[r] = (int)(recv_groups[r].size() * slice_sz);
    send_disps[r] = (r == 0) ? 0 : send_disps[r-1] + send_counts[r-1];
    recv_disps[r] = (r == 0) ? 0 : recv_disps[r-1] + recv_counts[r-1];
    total_send += send_counts[r];
    total_recv += recv_counts[r];
  }

  nda::array<ComplexType, 1> sendbuf(std::max(total_send, 1L));
  nda::array<ComplexType, 1> recvbuf(std::max(total_recv, 1L));

  auto W_full_loc = dW_full_wqPQ.local();
  long offset = 0;
  for (long r = 0; r < pgrid[1]; ++r) {
    for (auto const& [iq_loc_src, dest_iq_loc] : send_groups[r]) {
      (void)dest_iq_loc;
      for (long iw = 0; iw < nw_loc; ++iw)
        for (long iP = 0; iP < NP_loc; ++iP)
          for (long iQ = 0; iQ < NQ_loc; ++iQ)
            sendbuf(offset++) = W_full_loc(iw, iq_loc_src, iP, iQ);
    }
  }
  utils::check(offset == total_send,
               "_build_W_full_qpQ: send pack offset mismatch ({} != {})",
               offset, total_send);

  q_pool_comm.all_to_all_v_n(
      sendbuf.data(), send_counts.data(), send_disps.data(),
      recvbuf.data(), recv_counts.data(), recv_disps.data());

  auto W_full_qpQ_loc = dW_full_qpQ.local();
  offset = 0;
  for (long r = 0; r < pgrid[1]; ++r) {
    for (auto const& [iq_loc_dst, src_iq_loc] : recv_groups[r]) {
      (void)src_iq_loc;
      for (long iw = 0; iw < nw_loc; ++iw)
        for (long iP = 0; iP < NP_loc; ++iP)
          for (long iQ = 0; iQ < NQ_loc; ++iQ)
            W_full_qpQ_loc(iw, iq_loc_dst, iP, iQ) = recvbuf(offset++);
    }
  }
  utils::check(offset == total_recv,
               "_build_W_full_qpQ: recv unpack offset mismatch ({} != {})",
               offset, total_recv);

  _Timer.stop("LR_W_COMM_QPQ");
}

/**
 * LR W Dyson in Matsubara frequency space (in-place):
 *   ΔW_c(q, iω) = W_full(q+Q, iω) · ΔΠ(q, iω) · W_full(q, iω)
 *
 * Both arrays use the LR ω-side distribution {nwpools, nqpools, np_P, np_Q}
 * (matched grids). For Q=Γ the (q+Q) sector is local; for Q≠Γ we fetch the
 * required W_full slices from peers within q_pool_comm via Alltoallv.
 *
 * The two PQ multiplies are routed through nda::slate_ops::multiply, which
 * batches over the (iw, iq) leading axes and dispatches a SLATE GEMM on the
 * (P, Q) subgrid.
 */
template<nda::MemoryArray Array_4D_t, typename communicator_t,
         typename dW_full_t>
void lr_scr_coulomb_t::lr_dyson_W_in_place(
    memory::darray_t<Array_4D_t, communicator_t>& dDeltaPi_wqPQ,
    const dW_full_t& dW_full_wqPQ,
    const dW_full_t& dW_full_qpQ_wqPQ) {

  _Timer.start("EVALUATE_LR_W");

  auto pgrid = dDeltaPi_wqPQ.grid();
  auto bsize = dDeltaPi_wqPQ.block_size();
  auto& comm = *dDeltaPi_wqPQ.communicator();

  utils::check(pgrid == dW_full_wqPQ.grid() && pgrid == dW_full_qpQ_wqPQ.grid(),
               "lr_dyson_W_in_place: pgrid mismatch between ΔΠ and W_full operands");
  utils::check(bsize[1] == 1,
               "lr_dyson_W_in_place: q block size must be 1, got {}", bsize[1]);

  app_log(3, "  Evaluation of the LR screened interaction:");
  app_log(3, "    - processor grid for ΔW: (w, q, P, Q) = ({}, {}, {}, {})",
          pgrid[0], pgrid[1], pgrid[2], pgrid[3]);
  app_log(3, "    - q_pert is Γ: {}", _is_q_gamma ? "yes" : "no");

  // Intermediate buffer for matrix multiplication. Same distribution as ΔΠ.
  using local_Array_t = std::decay_t<Array_4D_t>;
  auto dTmp_wqPQ = math::nda::make_distributed_array<local_Array_t>(
      comm, pgrid, dDeltaPi_wqPQ.global_shape(), bsize);

  // SLATE's tileInsert is not const-correct (takes scalar_t*, not const
  // scalar_t*) even though it does not write to the input matrix. Cast away
  // const for the call. This is also the convention in scr_coulomb_t::dyson_W_in_place.
  auto& dW_full_nc     = const_cast<std::decay_t<dW_full_t>&>(dW_full_wqPQ);
  auto& dW_full_qpQ_nc = const_cast<std::decay_t<dW_full_t>&>(dW_full_qpQ_wqPQ);

  // ΔW = W_full(q+Q) · ΔΠ · W_full(q). For Q=Γ the caller passes the same object
  // for both operands, since W_full(q+Q) = W_full(q).
  math::nda::slate_ops::multiply(dW_full_qpQ_nc, dDeltaPi_wqPQ, dTmp_wqPQ);
  math::nda::slate_ops::multiply(dTmp_wqPQ, dW_full_nc, dDeltaPi_wqPQ);

  _Timer.stop("EVALUATE_LR_W");
}

/**
 * LR W Dyson: ΔΠ(τ) → ΔW_c(τ), in-place.
 *
 * Input: dDeltaPi_tqPQ in q-local (τ-dist) distribution.
 * On output: dDeltaPi_tqPQ is overwritten with ΔW_c(τ) in q-local distribution.
 *
 * Uses precomputed W_full(iω) in the LR ω-side distribution. The FT functions
 * handle the redistribute internally.
 */
template<nda::MemoryArrayOfRank<4> local_Array_t, typename communicator_t,
         typename dW_full_t>
void lr_scr_coulomb_t::solve_lr_dyson_W(
    memory::darray_t<local_Array_t, communicator_t>& dDeltaPi_tqPQ,
    const dW_full_t& dW_full_wqPQ,
    THC_ERI auto& thc)
{
  _Timer.start("SOLVE_LR_DYSON_W");
  _init_kpq_map(thc);

  // Leakage diagnostics inside the FT are verbosity-gated on the LR path.
  // __app_output_level__ holds a sentinel (-10000) on non-root ranks, and
  // check_leakage is collective (internal barrier + max-reduce), so broadcast
  // root's decision to keep the gate rank-uniform.
  int chk_leak = (__app_output_level__ >= 3) ? 1 : 0;
  thc.mpi()->comm.broadcast_n(&chk_leak, 1, 0);
  _scr_fourier.set_check_ft_leakage(chk_leak != 0);

  long nproc = thc.mpi()->comm.size();
  long NP = thc.Np();
  long nt_half = dDeltaPi_tqPQ.global_shape()[0];

  // --- Validate input: q-local dist ---
  utils::check_W_q_local_dist(dDeltaPi_tqPQ, "solve_lr_dyson_W(DeltaPi)");

  // ω-space distribution for the Dyson step: the per-(iω,q)-tile matmul
  // ΔW_c = W_full(q+Q)·ΔΠ·W_full(q) requires ΔΠ(iω) co-distributed with W_full,
  // so just adopt W_full's distribution. compute_W_full_omega already chose it
  // (fused FT-buffer layout when nproc ≤ nq, else the LR ω-side grid); tau_to_w
  // / w_to_tau then fuse away the matching redistribute automatically whenever
  // that layout is the FT-buffer one.
  auto w_pgrid = dW_full_wqPQ.grid();
  auto w_bsize = dW_full_wqPQ.block_size();

  // FT ΔΠ: τ → ω, output in LR ω-side distribution. The FT staging buffers are
  // allocated and released inside each tau_to_w / w_to_tau call: they are dead
  // weight (~1 F(τ) + 1 F(ω) grid) through the Dyson, HF and Σ phases, which is
  // far more memory than the per-call allocation costs in time.
  _Timer.start("LR_W_FT_TAU_TO_W");
  auto dDeltaPi_wqPQ = _scr_fourier.tau_to_w(dDeltaPi_tqPQ, w_pgrid, w_bsize, true);
  _Timer.stop("LR_W_FT_TAU_TO_W");

  // LR Dyson in ω-space (overwrites dDeltaPi_wqPQ with ΔW_c(iω)). The (q+Q)
  // operand is built once in compute_W_full_omega; thread the member cache into
  // the (stateless) Dyson. For Q=Γ, W_full(q+Q) = W_full(q) → pass dW_full_wqPQ
  // for both operands.
  if (_is_q_gamma) {
    lr_dyson_W_in_place(dDeltaPi_wqPQ, dW_full_wqPQ, dW_full_wqPQ);
  } else {
    utils::check(_dW_full_qpQ_wqPQ.has_value(),
                 "solve_lr_dyson_W: W_full(q+Q) not prepared for Q≠Γ "
                 "(compute_W_full_omega must run before the SCF loop)");
    lr_dyson_W_in_place(dDeltaPi_wqPQ, dW_full_wqPQ, *_dW_full_qpQ_wqPQ);
  }

  // FT back: ω → τ, output in q-local (τ-dist) distribution
  auto [q_pgrid, q_bsize] = utils::lr_W_q_local_dist(nproc, nt_half, NP);
  _Timer.start("LR_W_FT_W_TO_TAU");
  dDeltaPi_tqPQ = _scr_fourier.w_to_tau(dDeltaPi_wqPQ, q_pgrid, q_bsize, true);
  _Timer.stop("LR_W_FT_W_TO_TAU");

  _Timer.stop("SOLVE_LR_DYSON_W");

  // --- Per-step timer print (verbosity >= 3 only) ---
  print_timers(3);
}

} // solvers
} // methods
